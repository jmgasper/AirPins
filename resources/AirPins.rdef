resource app_signature "application/x-vnd.airOS-AirPins";
resource app_flags B_SINGLE_LAUNCH;
resource vector_icon { import "airpins-icon.hvif" };
resource app_version {
	major = 1, middle = 0, minor = 0, variety = B_APPV_FINAL, internal = 0,
	short_info = "AirPins 1.0.0 — Raspberry Pi GPIO",
	long_info = "Configure, drive and watch the Raspberry Pi's GPIO pins. A native Haiku version of pigg by Andrew Mackenzie."
};
resource file_types message {
	"types" = "application/x-vnd.pigg-config"
};
